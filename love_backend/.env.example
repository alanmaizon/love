# Copy to .env for local dev. In AWS, store these in SSM Parameter Store
# (SecureString) and inject as container `secrets`/`environment` — never bake
# real values into the image or commit them.

# --- Core ---
SECRET_KEY=change-me-generate-a-long-random-string
DEBUG=True
# JSON arrays (parsed by settings.py)
ALLOWED_HOSTS=["localhost","127.0.0.1"]
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
CSRF_TRUSTED_ORIGINS=["http://localhost:5173"]
# Leave blank to bind cookies to the current host (works on ALB DNS, custom
# domain, or localhost). Only set to a shared parent domain if API + frontend
# are on subdomains of it, e.g. ".lovethatgivesback.com".
COOKIE_DOMAIN=

# --- Database (prod: RDS connection string) ---
# Local default falls back to SQLite if unset.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# --- Email (local: console backend unless you set Gmail creds below) ---
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Legacy alias for Gmail app password
GOOGLE_APP_PASS=
DEFAULT_FROM_EMAIL=Love That Gives Back <noreply@lovethatgivesback.com>

# --- Stripe (TEST keys for local dev; live keys via SSM in prod) ---
# dashboard.stripe.com (Test mode) -> Developers -> API keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From: stripe listen --forward-to localhost:8000/api/payments/webhook/
STRIPE_WEBHOOK_SECRET=whsec_...
# Platform fee in basis points (100 = 1%). 0 -> 100% to charity.
PLATFORM_FEE_BPS=0
FRONTEND_URL=http://localhost:5173
STRIPE_CURRENCY=eur
# Optional: one test Connect account for all seed charities after import (see PHASE0.md)
# STRIPE_DEV_CONNECTED_ACCOUNT=acct_...

# --- Media storage (S3 via django-storages) ---
# Leave AWS_STORAGE_BUCKET_NAME unset locally -> uploads go to ./media (filesystem).
# In prod set the bucket; boto3 reads credentials from the ECS task role (no keys).
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# --- Integrations (optional) ---
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
