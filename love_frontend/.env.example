# Copy to .env.local for local dev (Vite reads .env.local, which is gitignored).
# Base URL of the Django API (no trailing /api — the axios instance appends it).
VITE_API_URL=http://localhost:8000

# Optional build-time fallback YouTube video id for the flagship campaign's
# livestream/recording. Per-campaign ids from the API (campaign.livestream_video_id)
# take precedence at runtime; this is only used when a campaign has none.
VITE_YOUTUBE_VIDEO_ID=dfcp0ehXXKg
